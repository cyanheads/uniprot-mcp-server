      "comments": [
        {
          "commentType": "DISEASE",
          "note": {
            "texts": [
              {
                "value": "TP53 is found in increased amounts in a wide variety of transformed cells. TP53 is frequently mutated or inactivated in about 60% of cancers. TP53 defects are found in Barrett metaplasia a condition in which the normally stratified squamous epithelium of the lower esophagus is replaced by a metaplastic columnar epithelium. The condition develops as a complication in approximately 10% of patients with chronic gastroesophageal reflux disease and predisposes to the development of esophageal adenocarcinoma"
              }
            ]
          }
        },
        {
          "commentType": "DISEASE",
          "disease": {
            "diseaseId": "Esophageal cancer",
            "diseaseAccession": "DI-01537",
            "acronym": "ESCR",
            "description": "A malignancy of the esophagus. The most common types are esophageal squamous cell carcinoma and adenocarcinoma. Cancer of the esophagus remains a devastating disease because it is usually not detected until it has progressed to an advanced incurable stage.",
            "diseaseCrossReference": { "database": "MIM", "id": "133239" }
