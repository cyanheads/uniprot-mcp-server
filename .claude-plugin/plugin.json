{
  "name": "uniprot-mcp-server",
  "version": "0.2.2",
  "description": "Protein research over UniProtKB — search by function, fetch curated records, map IDs, proteomes.",
  "author": {
    "name": "cyanheads"
  },
  "homepage": "https://github.com/cyanheads/uniprot-mcp-server#readme",
  "repository": "https://github.com/cyanheads/uniprot-mcp-server",
  "license": "Apache-2.0",
  "mcpServers": {
    "uniprot-mcp-server": {
      "command": "npx",
      "args": ["-y", "@cyanheads/uniprot-mcp-server"],
      "env": {
        "MCP_TRANSPORT_TYPE": "stdio"
      }
    }
  }
}
